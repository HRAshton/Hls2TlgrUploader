{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practice",
        "group:all"
    ],
    "labels": [
        "dependencies"
    ],
    "dependencyDashboard": true,
    "schedule": "* 6 * * 6",
    "timezone": "UTC",
    "prHourlyLimit": 2,
    "lockFileMaintenance": {
        "enabled": true
    },
    "automerge": true,
    "platformAutomerge": true,
    "automergeType": "pr",
    "automergeStrategy": "squash"
}
